{
  "name": "@platform/i18n",
  "version": "2.3.0",
  "description": "French Voice Standard i18n catalog + copy-lint (Execution Contract §10.5). All user-facing strings live here with register tags — never inline in app code.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./data-loader": {
      "types": "./dist/data-loader.d.ts",
      "import": "./dist/data-loader.js"
    },
    "./lint-cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    },
    "./catalog.json": "./catalog/catalog.json",
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "bin": {
    "copy-lint": "./dist/cli.js"
  },
  "files": [
    "dist",
    "data",
    "catalog"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepare": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
