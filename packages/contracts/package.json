{
  "name": "@platform/contracts",
  "version": "0.1.0",
  "description": "Canonical shared contracts (shapes + events), the money waterfall (RoundingLaw v1), the four branded secrets, canonical JSON, and the docs drift-check CLI. Shapes live ONLY here; no app redefines them.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "drift-check": "./dist/drift-check-cli.js"
  },
  "files": [
    "dist",
    "docs.manifest.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.typetest.json",
    "test": "vitest run",
    "prepare": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@platform/kernel-types": "workspace:*",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "fast-check": "^4.1.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
